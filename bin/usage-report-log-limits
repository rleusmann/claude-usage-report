#!/usr/bin/env bash
# Appends rate-limit snapshots from the status line JSON (stdin) to limits.jsonl.
# Only writes when a percentage or reset time changed, so it is cheap to call on every refresh.
set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/paths.sh"

state=$(jq -c '
  (.rate_limits // {}) as $r
  | {five_pct: $r.five_hour.used_percentage, five_reset: $r.five_hour.resets_at,
     week_pct: $r.seven_day.used_percentage, week_reset: $r.seven_day.resets_at}
  | select(.five_pct != null or .week_pct != null)
') || exit 0
[ -z "$state" ] && exit 0

mkdir -p "$DATA_DIR"
last_file="$DATA_DIR/.limits-last"
last="$(cat "$last_file" 2>/dev/null || true)"
if [ -n "$last" ]; then
  # Usage only grows within a window; parallel sessions may report slightly older values.
  newer=$(jq -n --argjson a "$last" --argjson b "$state" '
    ($a.five_reset != $b.five_reset) or ($a.week_reset != $b.week_reset)
    or (($b.five_pct // 0) > ($a.five_pct // 0)) or (($b.week_pct // 0) > ($a.week_pct // 0))') || newer=true
  [ "$newer" = "true" ] || exit 0
fi

printf '%s\n' "$state" >"$last_file"
jq -c --argjson ts "$(date +%s)" '{ts: $ts} + .' <<<"$state" >>"$LIMITS_PATH"
